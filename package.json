{
  "name": "@jigyasudham/veto",
  "mcpName": "io.github.jigyasudham/veto",
  "version": "3.0.0",
  "description": "93 agentic tools. 49 specialists. Every major AI CLI. Self-learning. Zero extra cost on subscriptions.",
  "keywords": [
    "mcp",
    "ai",
    "claude",
    "antigravity",
    "agents",
    "memory",
    "council",
    "gemini",
    "codex",
    "cursor",
    "windsurf",
    "vscode",
    "self-learning",
    "router",
    "workflow",
    "code-review",
    "agentic"
  ],
  "author": "Jigyasu Dham <jigyasudham18@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "veto": "dist/cli.js",
    "veto-server": "dist/server.js"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
